{
  "name": "reliquary-theme",
  "displayName": "Reliquary",
  "description": "A jewel-tone Gothic color theme matching the Reliquary terminal scheme — multiple simultaneous jewel-tone accents instead of one.",
  "version": "0.2.0",
  "publisher": "freehold-foundry",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark theme",
    "light theme",
    "jewel-tone",
    "gothic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Freehold-Foundry/reliquary-vscode-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Freehold-Foundry/reliquary-vscode-theme/issues"
  },
  "homepage": "https://github.com/Freehold-Foundry/reliquary-vscode-theme#readme",
  "galleryBanner": {
    "color": "#14141A",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Reliquary",
        "uiTheme": "vs-dark",
        "path": "./themes/reliquary-color-theme.json"
      },
      {
        "label": "Reliquary Light",
        "uiTheme": "vs",
        "path": "./themes/reliquary-light-color-theme.json"
      }
    ]
  },
